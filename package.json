{
  "name": "mailengin",
  "version": "0.1.0",
  "description": "Official Node.js SDK for the MailEngin Email API",
  "keywords": [
    "mailengin",
    "email",
    "email-api",
    "transactional-email",
    "typescript"
  ],
  "homepage": "https://github.com/vishveshrathore/mailengin-node-sdk#readme",
  "license": "MIT",
  "author": "MailEngin",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const path of ['dist','coverage']) fs.rmSync(path,{recursive:true,force:true})\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/mailengin.test.mjs",
    "test:watch": "node --test --watch test/mailengin.test.mjs",
    "check": "npm run typecheck && npm run build && npm run test",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishveshrathore/mailengin-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/vishveshrathore/mailengin-node-sdk/issues"
  }
}
